{
  "version": 2,
  "crons": [
    {
      "path": "/api/news/ingest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/drafts/generate-daily",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
