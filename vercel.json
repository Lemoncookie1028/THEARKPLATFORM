{
  "version": 2,
  "crons": [
    {
      "path": "/api/news/ingest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/drafts/generate-daily",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth-handler?action=:action" },
    { "source": "/api/posts/:action", "destination": "/api/posts-handler?action=:action" },
    { "source": "/api/drafts/:action", "destination": "/api/drafts-handler?action=:action" },
    { "source": "/api/flags/:action", "destination": "/api/flags-handler?action=:action" }
  ]
}
