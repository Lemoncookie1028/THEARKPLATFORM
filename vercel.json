{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ],
  "env": {
    "FIREBASE_PROJECT_ID": "thearkplatform",
    "FIREBASE_CLIENT_EMAIL": "firebase-adminsdk@thearkplatform.iam.gserviceaccount.com",
    "FIREBASE_PRIVATE_KEY": "@firebase-private-key",
    "FIREBASE_API_KEY": "AIzaSyCo2C4wAtqOmST_0xQoAgB8dx9LYsIbuts",
    "FIREBASE_AUTH_DOMAIN": "thearkplatform.firebaseapp.com",
    "FIREBASE_STORAGE_BUCKET": "thearkplatform.firebasestorage.app"
  }
}