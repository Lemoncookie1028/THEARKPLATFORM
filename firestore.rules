rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Private account data — only the account owner can read or write it.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if false; // created server-side via the Admin SDK on signup
      allow delete: if false;

      match /follows/{followedId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /saved/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public creator profiles — anyone can view, only the creator can edit
    // their own doc. `followers` is intentionally excluded from client writes
    // (it's only ever incremented/decremented via the follow API path).
    match /creators/{creatorId} {
      allow read: if true;
      allow update: if request.auth != null
                    && request.auth.uid == creatorId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followers']);
      allow create, delete: if false;
    }

    // Posts — public read (this is a public feed). Writes go through
    // /api/posts/create, which runs as the Admin SDK, so client-side
    // writes are disabled here to keep the source-attachment and
    // moderation logic from being bypassable.
    match /posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Fixed topic taxonomy — read-only from the client.
    match /topics/{topicId} {
      allow read: if true;
      allow write: if false;
    }

    // Moderation queue — anyone signed in can file a flag, only server-side
    // (Admin SDK) code can read/resolve them.
    match /flags/{flagId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // AI-drafted content awaiting review — never client-readable or
    // client-writable. Only reachable through /api/drafts/*, which is
    // gated to admin accounts and runs via the Admin SDK.
    match /drafts/{draftId} {
      allow read, write: if false;
    }
  }
}
